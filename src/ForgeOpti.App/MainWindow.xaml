<Window x:Class="ForgeOpti.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Padding="20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="480" MinWidth="200" VerticalAlignment="Center"
                     AutomationProperties.Name="Rechercher un réglage"
                     PlaceholderText="Rechercher un réglage (ex. widgets, télémétrie, souris)…" TextChanged="Search_Changed"/>
            <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer x:Name="TopNavScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TopNav" Orientation="Horizontal" Spacing="4" Padding="16,4,16,8"/>
        </ScrollViewer>

        <Grid x:Name="Body" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="SideScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SideNav" Padding="10,10,10,16" Spacing="2"/>
            </ScrollViewer>
            <ScrollViewer x:Name="MainScroll" Grid.Column="1" SizeChanged="Main_SizeChanged" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Main" Padding="28,16,32,28" Spacing="10"/>
            </ScrollViewer>
        </Grid>

        <Border x:Name="PendingBar" Grid.Row="3" Visibility="Collapsed" Padding="20,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PendingText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel x:Name="PendingButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8"/>
            </Grid>
        </Border>

        <Grid x:Name="StatusBar" Grid.Row="4" Padding="20,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Busy" Width="70" VerticalAlignment="Center" IsIndeterminate="False" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" Grid.Column="1" Text="Prêt." VerticalAlignment="Center"/>
        </Grid>
        <!-- Voile : bloque souris pendant une application sans changer l'état visuel des contrôles (pas de transitions Disabled) -->
        <Border x:Name="BusyShield" Grid.RowSpan="5" Visibility="Collapsed" Background="#01000000"/>
    </Grid>
</Window>
