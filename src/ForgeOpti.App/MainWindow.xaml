<Window x:Class="ForgeOpti.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Padding="24,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ForgeOpti" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Optimisation de Windows 10 / 11 : tout est réversible" Opacity="0.7"/>
            </StackPanel>
            <Button x:Name="BtnOneClick" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="⚡ Optimiser en 1 clic" Click="OneClick_Click"/>
            <Button x:Name="BtnUndoAll" Grid.Column="2" Content="↩ Tout annuler" Click="UndoAll_Click"/>
            <StackPanel Grid.Column="3" Spacing="4">
                <Button Content="Rechercher une mise à jour" Click="Update_Click"/>
                <CheckBox x:Name="ChkAuto" Content="Mises à jour automatiques" Click="Auto_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListView x:Name="Cats" SelectionChanged="Cats_SelectionChanged" Padding="8,0"/>
            <ScrollViewer Grid.Column="1"><StackPanel x:Name="List" Padding="16,0,24,16" Spacing="6"/></ScrollViewer>
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="2" Padding="24,8" Text="Prêt." Opacity="0.8"/>
    </Grid>
</Window>
