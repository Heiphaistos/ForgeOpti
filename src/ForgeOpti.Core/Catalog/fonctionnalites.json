  {
    "id": "feat.internet-explorer-optional-amd64",
    "category": "Fonctionnalités Windows",
    "name": "Retirer Internet Explorer (fonctionnalité)",
    "description": "Désactive Internet Explorer et son mode hérité sur Windows 10. Edge reste fonctionnel.",
    "risk": "Modere",
    "reboot": true,
    "gaming": false,
    "oneClick": false,
    "ops": [
      {
        "type": "cmd",
        "apply": "$n='Internet-Explorer-Optional-amd64';$d=\"$env:ProgramData\\ForgeOpti\\feat\";$f=$null;try{$f=Get-WindowsOptionalFeature -Online -FeatureName $n -ErrorAction Stop}catch{};if($f -and $f.State -eq 'Enabled'){New-Item -ItemType Directory -Force $d|Out-Null;Set-Content -Path \"$d\\$n.was\" -Value 1;Disable-WindowsOptionalFeature -Online -FeatureName $n -NoRestart|Out-Null}",
        "revert": "$n='Internet-Explorer-Optional-amd64';$m=\"$env:ProgramData\\ForgeOpti\\feat\\$n.was\";if(Test-Path $m){Enable-WindowsOptionalFeature -Online -FeatureName $n -NoRestart|Out-Null;Remove-Item $m -Force}"
      }
    ]
  },
