 {
  "id": "gaming.tick-dynamique",
  "category": "Gaming",
  "name": "Désactiver le tick dynamique (timer)",
  "description": "Maintient une horloge système régulière : latence d'entrée plus stable, consommation légèrement accrue. Modifie bcdedit.",
  "risk": "Avance",
  "reboot": true,
  "gaming": true,
  "oneClick": false,
  "ops": [
   {
    "type": "cmd",
    "apply": "bcdedit /set disabledynamictick yes",
    "revert": "bcdedit /deletevalue disabledynamictick"
   }
  ]
 },
 {
  "id": "gaming.horloge-plateforme",
  "category": "Gaming",
  "name": "Retirer le forçage de l'horloge HPET",
  "description": "Ne force plus l'horloge plateforme (useplatformclock) au profit du TSC. Modifie bcdedit.",
  "risk": "Avance",
  "reboot": true,
  "gaming": true,
  "oneClick": false,
  "ops": [
   {
    "type": "cmd",
    "apply": "bcdedit /set useplatformclock no",
    "revert": "bcdedit /deletevalue useplatformclock"
   }
  ]
 }
