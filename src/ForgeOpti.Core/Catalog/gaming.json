[
 {
  "id": "gaming.gamemode",
  "category": "Gaming",
  "name": "Activer le mode Jeu",
  "description": "Priorise les ressources pour le jeu au premier plan et limite les tâches de fond.",
  "risk": "Sur",
  "reboot": false,
  "gaming": true,
  "oneClick": true,
  "ops": [
   {
    "type": "reg",
    "hive": "HKCU",
    "key": "Software\\Microsoft\\GameBar",
    "name": "AutoGameModeEnabled",
    "kind": "DWord",
    "value": 1
   },
   {
    "type": "reg",
    "hive": "HKCU",
    "key": "Software\\Microsoft\\GameBar",
    "name": "AllowAutoGameMode",
    "kind": "DWord",
    "value": 1
   }
  ]
 },
