  {
    "id": "edge.desinstaller",
    "category": "Edge et OneDrive",
    "name": "Désinstaller Microsoft Edge",
    "description": "Retire Edge via son programme d'installation. WebView2 n'est pas touché. Réinstallation par winget (Microsoft.Edge).",
    "risk": "Avance",
    "reboot": false,
    "gaming": false,
    "oneClick": false,
    "ops": [
      {
        "type": "reg",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\EdgeUpdateDev",
        "name": "AllowUninstall",
        "kind": "DWord",
        "value": 1
      },
      {
        "type": "cmd",
        "apply": "$s=Get-ChildItem \"${env:ProgramFiles(x86)}\\Microsoft\\Edge\\Application\\*\\Installer\\setup.exe\" -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | Select-Object -First 1; if ($s) { Start-Process $s.FullName -ArgumentList '--uninstall --system-level --verbose-logging --force-uninstall' -Wait }",
        "revert": "winget install --id Microsoft.Edge --accept-package-agreements --accept-source-agreements --silent; if ($LASTEXITCODE -ne 0) { throw 'winget a echoue' }"
      }
    ]
  },
