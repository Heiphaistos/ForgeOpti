  {
    "id": "od.desinstaller",
    "category": "Edge et OneDrive",
    "name": "Désinstaller OneDrive",
    "description": "Ferme OneDrive et le désinstalle (les fichiers locaux sont conservés). Réinstallation par winget (Microsoft.OneDrive).",
    "risk": "Avance",
    "reboot": false,
    "gaming": false,
    "oneClick": false,
    "ops": [
      {
        "type": "cmd",
        "apply": "Stop-Process -Name OneDrive -Force -ErrorAction SilentlyContinue; $p=\"$env:SystemRoot\\SysWOW64\\OneDriveSetup.exe\"; if (-not (Test-Path $p)) { $p=\"$env:SystemRoot\\System32\\OneDriveSetup.exe\" }; if (Test-Path $p) { Start-Process $p -ArgumentList '/uninstall' -Wait }",
        "revert": "winget install --id Microsoft.OneDrive --accept-package-agreements --accept-source-agreements --silent; if ($LASTEXITCODE -ne 0) { throw 'winget a echoue' }"
      }
    ]
